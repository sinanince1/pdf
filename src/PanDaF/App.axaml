<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PanDaF.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F6F4F1"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#E3DED7"/>
    <SolidColorBrush x:Key="Ink" Color="#1F2328"/>
    <SolidColorBrush x:Key="Muted" Color="#5E6670"/>
    <SolidColorBrush x:Key="Primary" Color="#D9480F"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#BF3E0B"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#A33408"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#FDEDE5"/>
    <SolidColorBrush x:Key="Success" Color="#16805C"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#E3F4EC"/>
    <SolidColorBrush x:Key="Hover" Color="#F1EDE8"/>

    <!-- Simgeler: 24×24, kendi çizimimiz -->
    <StreamGeometry x:Key="IconMerge">M4 4h9v3h-9zM4 10.5h9v3h-9zM4 17h9v3h-9zM15 11l5 1-5 1zM14.5 9.5l5.5 2.5-5.5 2.5v-1.5h-2v-2h2z</StreamGeometry>
    <StreamGeometry x:Key="IconSplit">M6 3a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm0 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM6 15a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm0 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM9 7.5l12 7.5-1.1 1.7L8 9.2zM9 16.5l12-7.5 1.1 1.7L8 14.8z</StreamGeometry>
    <StreamGeometry x:Key="IconOrganize">M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8zM5 5v4h4V5zM15 5v4h4V5zM5 15v4h4v-4zM15 15v4h4v-4z</StreamGeometry>
