<Window x:Class="PanDaF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PanDaF" Width="1060" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="15" Foreground="{StaticResource Ink}"
        Icon="Assets/PanDaF.png" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Üst çubuk -->
    <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel LastChildFill="True">
        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Settings_Click" ToolTip="Shift paneli, otomatik başlatma ve uygulama hakkında">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" Margin="0,0,8,0"/>
            <TextBlock Text="Ayarlar"/>
          </StackPanel>
        </Button>
        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,12,0" ToolTip="Ana sayfaya dön (Esc)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="15" Margin="0,0,8,0"/>
            <TextBlock Text="Ana sayfa"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/PanDaF.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="PanDaF" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="PageTitle" FontSize="17" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Host" Grid.Row="1" Focusable="False"/>

    <!-- İşlem sürüyor -->
    <Grid x:Name="BusyOverlay" Grid.RowSpan="2" Background="#99202020" Visibility="Collapsed">
      <Border Style="{StaticResource CardBorder}" Width="480" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="BusyTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="BusyLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" Text="Hazırlanıyor…"/>
          <ProgressBar x:Name="BusyBar" Minimum="0" Maximum="1" IsIndeterminate="True"/>
          <Button x:Name="CancelButton" Content="İptal" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" Click="Cancel_Click"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Sonuç -->
    <Grid x:Name="ResultOverlay" Grid.RowSpan="2" Background="#99202020" Visibility="Collapsed">
      <Border Style="{StaticResource CardBorder}" Width="540" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SuccessSoft}" Margin="0,0,14,0">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="18" Foreground="{StaticResource Success}"/>
            </Border>
            <TextBlock Text="Hazır!" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="ResultMessage" TextWrapping="Wrap" FontSize="15"/>
          <TextBlock x:Name="ResultPath" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
          <WrapPanel HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="ResultOpenFolder" Content="Klasörü göster" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ResultOpenFolder_Click"/>
            <Button x:Name="ResultOpen" Content="Aç" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ResultOpen_Click"/>
            <Button x:Name="ResultOk" Content="Tamam" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="ResultOk_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
