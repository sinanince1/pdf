<UserControl x:Class="PanDaF.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="View_KeyDown">
  <UserControl.Resources>
    <Style x:Key="Tool" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="10,6" ToolTip="{TemplateBinding ToolTip}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Hover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource PrimarySoft}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolLabel" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <ContentControl x:Name="DropHost" Focusable="False" Margin="20,12,20,0"/>
      <!-- Araç çubuğu -->
      <Border x:Name="Toolbar" Visibility="Collapsed" Padding="8,6" CornerRadius="12" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" Click="Undo_Click" IsEnabled="False" ToolTip="Geri al (Ctrl+Z)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="15"/>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource GhostButton}" Click="Delete_Click" IsEnabled="False" ToolTip="Seçili öğeyi sil (Delete)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15"/>
            </Button>
          </StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <RadioButton x:Name="SelectTool" Style="{StaticResource Tool}" GroupName="Tool" IsChecked="True" ToolTip="Seç ve taşı">
              <StackPanel Style="{StaticResource ToolLabel}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Seç"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="RewriteTool" Style="{StaticResource Tool}" GroupName="Tool" ToolTip="Var olan yazıyı değiştir: satıra tıklayın, yenisini yazın, Enter'a basın. Aynı yazı tipiyle, yerinde değişir.">
              <StackPanel Style="{StaticResource ToolLabel}"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Yazıyı değiştir"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="TextTool" Style="{StaticResource Tool}" GroupName="Tool" ToolTip="Yeni yazı kutusu: sayfada tıklayıp yazın">
              <StackPanel Style="{StaticResource ToolLabel}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Yeni yazı"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="WhiteoutTool" Style="{StaticResource Tool}" GroupName="Tool" ToolTip="Kapat: bir alanı beyazla örter; üstüne yeni yazı yazabilirsiniz">
              <StackPanel Style="{StaticResource ToolLabel}"><TextBlock Style="{StaticResource Icon}" Text="&#xE75C;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Kapat"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="HighlightTool" Style="{StaticResource Tool}" GroupName="Tool" ToolTip="Vurgula (fosforlu kalem)">
              <StackPanel Style="{StaticResource ToolLabel}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Vurgula"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="PenTool" Style="{StaticResource Tool}" GroupName="Tool" ToolTip="Kalem: serbest çizim">
              <StackPanel Style="{StaticResource ToolLabel}"><TextBlock Style="{StaticResource Icon}" Text="&#xEE56;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Kalem"/></StackPanel>
            </RadioButton>
            <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="6,0"/>
            <Button Style="{StaticResource GhostButton}" Click="AddImage_Click" ToolTip="Bilgisayarınızdan resim veya imza ekleyin">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Resim"/></StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Click="AddIstek_Click" ToolTip="İSTEK logosunu sol üste ekle">
              <StackPanel Orientation="Horizontal"><Image Source="/Assets/LogoIstek.png" Height="18" Margin="0,0,6,0"/><TextBlock Text="İSTEK"/></StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Click="AddIB_Click" ToolTip="IB logosunu sağ üste ekle">
              <StackPanel Orientation="Horizontal"><Image Source="/Assets/LogoIB.png" Height="18" Margin="0,0,6,0"/><TextBlock Text="IB"/></StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Click="AddBoth_Click" ToolTip="Her sayfaya iki logoyu da ekle">
              <TextBlock Text="İkisini her sayfaya"/>
            </Button>
            <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="6,0"/>
            <!-- Yazı seçenekleri -->
            <StackPanel x:Name="TextOptions" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox x:Name="FontSizeBox" Width="64" FontSize="13" SelectedIndex="2" SelectionChanged="TextOption_Changed" ToolTip="Yazı boyutu">
                <ComboBoxItem Content="10"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="22"/><ComboBoxItem Content="28"/><ComboBoxItem Content="36"/>
              </ComboBox>
              <ToggleButton x:Name="BoldBox" Content="K" FontWeight="Bold" Width="30" Height="28" Margin="6,0,0,0" Click="TextOption_Changed" ToolTip="Kalın"/>
            </StackPanel>
            <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <StackPanel x:Name="PenOptions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
              <TextBlock Text="Kalınlık" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Slider x:Name="PenWidth" Width="80" Minimum="1" Maximum="12" Value="2.5" VerticalAlignment="Center"/>
            </StackPanel>
          </WrapPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Sayfa -->
    <Border Grid.Row="1" x:Name="PageArea" Visibility="Collapsed" Margin="0,10,0,0" Background="#DED9D2" CornerRadius="12" ClipToBounds="True">
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="PageHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24">
          <Border Background="White" Effect="{x:Null}">
            <Border.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Border.LayoutTransform>
            <Grid>
              <Image x:Name="PageImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
              <Canvas x:Name="Overlay" Background="Transparent" Cursor="Arrow"
                      MouseLeftButtonDown="Overlay_Down" MouseMove="Overlay_Move" MouseLeftButtonUp="Overlay_Up" MouseLeave="Overlay_Leave"/>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </Border>

    <!-- Alt çubuk -->
    <Border Grid.Row="2" x:Name="Footer" Visibility="Collapsed" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Yeni PDF olarak kaydet" Click="Save_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Click="PrevPage_Click" ToolTip="Önceki sayfa (Page Up)"><TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="14"/></Button>
          <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="6,0" MinWidth="90" TextAlignment="Center"/>
          <Button Style="{StaticResource GhostButton}" Click="NextPage_Click" ToolTip="Sonraki sayfa (Page Down)"><TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="14"/></Button>
          <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="10,0"/>
          <Button Style="{StaticResource GhostButton}" Click="ZoomOut_Click" ToolTip="Uzaklaş"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" FontSize="14"/></Button>
          <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="6,0" MinWidth="44" TextAlignment="Center" Text="100%"/>
          <Button Style="{StaticResource GhostButton}" Click="ZoomIn_Click" ToolTip="Yakınlaş"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="14"/></Button>
          <Button Style="{StaticResource GhostButton}" Click="ZoomFit_Click" Content="Sığdır"/>
          <TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
