<UserControl x:Class="PanDaF.Views.OrganizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="View_KeyDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <Grid Margin="32,24,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="8,0,8,0">
      <TextBlock Style="{StaticResource Title}" Text="Sayfaları düzenle"/>
      <TextBlock Style="{StaticResource Subtitle}" Text="Sayfaya tıklayarak seçin. Sırasını değiştirmek için sayfayı tutup başka bir sayfanın üzerine sürükleyin."/>
    </StackPanel>

    <!-- Araç çubuğu -->
    <Border x:Name="Toolbar" Grid.Row="1" Visibility="Collapsed" Margin="8,16,8,8" Padding="10,8" CornerRadius="12" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Change_Click" ToolTip="Başka bir PDF açın">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Başka PDF"/>
          </StackPanel>
        </Button>
        <WrapPanel>
          <Button Style="{StaticResource GhostButton}" Click="SelectAll_Click" ToolTip="Tüm sayfaları seç (Ctrl+A)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock x:Name="SelectAllText" Text="Tümünü seç"/>
            </StackPanel>
          </Button>
          <Button x:Name="RotateSelected" Style="{StaticResource GhostButton}" Click="RotateSelected_Click" IsEnabled="False" ToolTip="Seçili sayfaları sağa döndür">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Seçilenleri döndür"/>
            </StackPanel>
          </Button>
          <Button x:Name="DeleteSelected" Style="{StaticResource GhostButton}" Click="DeleteSelected_Click" IsEnabled="False" ToolTip="Seçili sayfaları sil (Delete)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Seçilenleri sil"/>
            </StackPanel>
          </Button>
          <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" Click="Undo_Click" IsEnabled="False" ToolTip="Son değişikliği geri al (Ctrl+Z)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Geri al"/>
            </StackPanel>
          </Button>
          <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Click="Reset_Click" IsEnabled="False" ToolTip="Tüm değişiklikleri geri al">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Baştan başla"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,4,0,0">
      <ContentControl x:Name="DropHost" Focusable="False" Margin="8,16,8,0"/>
      <ScrollViewer x:Name="Editor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="PagesView" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Card" Width="178" Margin="8" Padding="10" CornerRadius="12" Background="{StaticResource Card}"
                      BorderBrush="{StaticResource Line}" BorderThickness="2" Cursor="Hand" AllowDrop="True" ToolTip="{Binding Tip}"
                      PreviewMouseLeftButtonDown="Card_Down" MouseMove="Card_Move" MouseLeftButtonUp="Card_Up"
                      DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                <StackPanel>
                  <Grid Height="206">
                    <Border Background="{StaticResource Hover}" CornerRadius="6"/>
                    <TextBlock Text="Yükleniyor…" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Loading, Converter={StaticResource Visible}}"/>
                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.LayoutTransform>
                        <RotateTransform Angle="{Binding Rotation}"/>
                      </Image.LayoutTransform>
                    </Image>
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                            Visibility="{Binding Selected, Converter={StaticResource Visible}}">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="White"/>
                    </Border>
                  </Grid>
                  <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Bu sayfayı sil" Click="DeleteOne_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Bu sayfayı sağa döndür" Click="RotateOne_Click"/>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}"/>
                  <Setter TargetName="Card" Property="Background" Value="{StaticResource PrimarySoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropTarget}" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Success}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="3" Margin="8,14,8,0" Padding="0,14,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button x:Name="Go" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Yeni PDF olarak kaydet" IsEnabled="False" Click="Go_Click"/>
        <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Düzenlemek için bir PDF seçin."/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
